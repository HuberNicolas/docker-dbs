# Optional overrides for compose.yaml. Copy to `.env` and change what you need:
#   cp .env.example .env
# Every value below is the default that applies without a `.env` file.
# These are local development credentials. Do not reuse them anywhere else.

# Start these profiles with a plain `docker compose up` (comma-separated, e.g. postgres,mongodb).
# COMPOSE_PROFILES=all

# MariaDB + phpMyAdmin
MARIADB_PORT=3307
MARIADB_ROOT_PASSWORD=mariadb-root-pw
MARIADB_USER=mariadb-user
MARIADB_PASSWORD=mariadb-user-pw
PHPMYADMIN_PORT=8081

# PostgreSQL + pgAdmin
POSTGRES_PORT=5433
POSTGRES_USER=postgres-user
POSTGRES_PASSWORD=postgres-user-pw
PGADMIN_PORT=5051
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin-user-pw

# MongoDB + Mongo Express
MONGODB_PORT=27018
MONGODB_ROOT_USERNAME=mongodb-root
MONGODB_ROOT_PASSWORD=mongodb-root-pw
MONGO_EXPRESS_PORT=8082
MONGO_EXPRESS_USERNAME=mongo-express-user
MONGO_EXPRESS_PASSWORD=mongo-express-user-pw

# Valkey + RedisInsight
VALKEY_PORT=6380
VALKEY_PASSWORD=valkey-pw
REDISINSIGHT_PORT=5540

# Neo4j (password needs at least 8 characters)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=neo4j-user-pw

# Qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant-api-key
